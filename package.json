{
  "name": "financ-you",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicação para cadastrar e consultar rendas com Supabase",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "npm --prefix client run dev",
    "start": "node server/index.js",
    "build": "npm --prefix client run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
